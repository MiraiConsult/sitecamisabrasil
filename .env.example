# ===== Asaas =====
# Chave de API do Asaas (NUNCA comite a chave real).
# Sandbox: pegue em https://sandbox.asaas.com  -> Integrações -> Chave de API
# Produção: pegue em https://www.asaas.com      -> Integrações -> Chave de API
ASAAS_API_KEY=

# Ambiente do Asaas: "sandbox" (testes) ou "production" (valendo de verdade)
ASAAS_ENV=sandbox

# (Opcional) Sobrescreve a URL base do Asaas. Normalmente não precisa.
# Sandbox:   https://sandbox.asaas.com/api/v3
# Produção:  https://api.asaas.com/v3
# ASAAS_BASE_URL=

# (Opcional) Token do webhook do Asaas. Se preenchido, o endpoint
# /api/webhooks/asaas vai exigir o header asaas-access-token igual a este valor.
ASAAS_WEBHOOK_TOKEN=

# ===== Site =====
# URL pública do site (usada para o Asaas redirecionar o cliente após pagar).
# Em produção use a URL final, ex: https://camisabrasil.rruniformes.com.br
# Em desenvolvimento pode deixar em branco (o sistema detecta pelo host da requisição).
NEXT_PUBLIC_SITE_URL=

# ===== Painel de pedidos (/admin) =====
# Senha para acessar a tabela de pedidos em /admin. Use uma senha forte.
# Os pedidos são lidos em tempo real do Asaas (sem banco de dados).
ADMIN_PASSWORD=
